              "minLength": 1
            },
            "role": {
              "type": "string",
              "title": "Rolle",
              "default": "all",
              "maxLength": 160,
              "enum": [
                "all",
                "farmer",
                "merchant"
              ],
              "x-labels": {
                "all": "Alle Rollen",
                "farmer": "Farmer",
                "merchant": "Merchant"
              }
            },
            "character": {
              "type": "string",
              "title": "Nur Charakter (leer = alle)",
              "default": "",
              "maxLength": 160,
              "x-catalog": "characters"
            },
            "minLevel": {
              "type": "integer",
              "title": "Ab Item-Level",
              "default": 0,
              "minimum": 0,
              "maximum": 99
            },
            "maxLevel": {
              "type": "integer",
              "title": "Bis Item-Level",
              "default": 99,
              "minimum": 0,
              "maximum": 99
            },
            "statType": {
              "type": "string",
              "title": "Stat-Typ (leer = alle)",
              "default": "",
              "maxLength": 160
            },
            "property": {
              "type": "string",
              "title": "Eigenschaft p (leer = alle)",
              "default": "",
              "maxLength": 160
            },
            "title": {
              "type": "string",
              "title": "Item-Titel (leer = alle)",
