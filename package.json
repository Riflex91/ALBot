{
  "name": "albot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:bootstrap": "node scripts/build-bootstrap.mjs --write",
    "check:bootstrap": "node scripts/build-bootstrap.mjs --check",
    "build:bootstrap:auto": "node scripts/build-auto-bootstrap.mjs --write",
    "check:bootstrap:auto": "node scripts/build-auto-bootstrap.mjs --check",
    "verify:release": "node scripts/sign-release.mjs --check",
    "sign:release": "node scripts/sign-release.mjs --write",
    "test": "node --test test/*.test.mjs editor/test/*.test.mjs konfigurator/test/*.test.mjs",
    "build:editor": "node editor/build.mjs",
    "test:editor": "node --test editor/test/*.test.mjs",
    "build:konfigurator": "node konfigurator/scripts/prepare.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "acorn": "8.19.0"
  }
}
