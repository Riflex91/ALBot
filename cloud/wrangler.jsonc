{
  "name": "albot-learning-new",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "BudgetLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetLedger"] }],
  "vars": {
    "FREE_PLANS_CONFIRMED": "false",
    "BUDGET_VERIFIED_AT": "",
    "CHARACTERS": "",
    "ALLOWED_ORIGINS": "https://adventure.land",
    "SUPABASE_ENABLED": "false",
    "B2_ENABLED": "false",
    "BOUNDED_RETENTION": "true",
    "AI_ENABLED": "false",
    "AI_FREE_PLAN_CONFIRMED": "false"
  }
}
