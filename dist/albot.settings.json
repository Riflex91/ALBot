              "maxLength": 160
            },
            "task": {
              "type": "string",
              "title": "Nur Aktivität (leer = alle)",
              "default": "",
              "maxLength": 160
            },
            "action": {
              "type": "string",
              "title": "Aktion",
              "default": "keep",
              "maxLength": 160,
              "enum": [
                "keep",
                "consume",
                "send"
              ],
              "x-labels": {
                "keep": "Behalten / reservieren",
                "consume": "Verbrauch erlauben",
                "send": "Überschuss liefern"
              }
            },
            "keep": {
              "type": "integer",
              "title": "Mindestbestand behalten",
